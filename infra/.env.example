# Copy to infra/.env (git-ignored) and fill in. Read by docker compose and by the api/migrate
# containers (env_file). Values marked (secret) never go anywhere else.

# Public host name served by the proxy (no scheme). Certificates are issued for it.
VERIXA_PUBLIC_HOST=app.example.com
VERIXA_ACME_EMAIL=ops@example.com
VERIXA_IMAGE_TAG=local

# PostgreSQL (the db service). (secret)
POSTGRES_DB=verixa
POSTGRES_USER=verixa
POSTGRES_PASSWORD=

# Private object storage. Any S3-compatible bucket; must never be public-read. (secret)
# With the MinIO profile: VERIXA_S3_ENDPOINT_URL=https://files.${VERIXA_PUBLIC_HOST}, region auto.
VERIXA_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
VERIXA_S3_REGION=auto
VERIXA_S3_BUCKET=verixa-private
VERIXA_S3_ACCESS_KEY_ID=
VERIXA_S3_SECRET_ACCESS_KEY=

# Token signing key: python -c "import secrets; print(secrets.token_urlsafe(48))" (secret)
VERIXA_SECRET_KEY=
# Bearer token for /metrics (required while metrics are enabled). (secret)
VERIXA_METRICS_TOKEN=

# Providers (all optional; "none" keeps the step skipped and reported as such).
VERIXA_LLM_PROVIDER=none
VERIXA_OPENAI_API_KEY=
VERIXA_OPENAI_MODEL=gpt-4o-mini
VERIXA_AI_DETECTOR_PROVIDER=none
VERIXA_SOURCE_SEARCH_PROVIDER=none

# Retention and limits (see services/api/.env.example for every setting and its default).
VERIXA_RAW_CONTENT_RETENTION_HOURS=24
VERIXA_USAGE_MONTHLY_ANALYSIS_LIMIT=0

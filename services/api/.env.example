# Copy to .env and adjust. Never commit .env.
VERIXA_ENVIRONMENT=development
VERIXA_DEBUG=false
VERIXA_CORS_ORIGINS=["http://localhost:3000"]

# Auth. Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The built-in development default is refused when VERIXA_ENVIRONMENT=production.
VERIXA_SECRET_KEY=
VERIXA_ACCESS_TOKEN_TTL_MINUTES=30
VERIXA_REFRESH_TOKEN_TTL_DAYS=14

# Abuse controls (per API process; 0 disables). Failed logins per email and per client address
# inside the window, registrations per client address per hour. Trust X-Forwarded-For only
# behind a proxy that overwrites it.
VERIXA_LOGIN_MAX_ATTEMPTS=10
VERIXA_LOGIN_MAX_ATTEMPTS_PER_IP=50
VERIXA_LOGIN_WINDOW_MINUTES=15
VERIXA_REGISTER_MAX_PER_HOUR=20
VERIXA_TRUST_PROXY_HEADERS=false

# SSRF guard: hosts (and subdomains) provider adapters may call over https. Outside production,
# plain-http localhost stubs are also accepted.
VERIXA_OUTBOUND_ALLOWED_HOSTS=["api.openai.com"]

# Metadata engine: auto | exiftool | pillow. ExifTool is found on PATH or via VERIXA_EXIFTOOL_PATH.
VERIXA_METADATA_ENGINE=auto
# VERIXA_EXIFTOOL_PATH=C:/Users/you/AppData/Local/Programs/ExifTool/ExifTool.exe
VERIXA_EXIFTOOL_TIMEOUT_SECONDS=30

# Provenance engine: auto | c2patool | none. c2patool is found on PATH or via VERIXA_C2PATOOL_PATH.
VERIXA_PROVENANCE_ENGINE=auto
# VERIXA_C2PATOOL_PATH=C:/Users/you/AppData/Local/Programs/c2patool/c2patool/c2patool.exe
VERIXA_C2PATOOL_TIMEOUT_SECONDS=30

# Near-duplicate detection: max Hamming distance (0-64 bits) on pHash or dHash.
VERIXA_FINGERPRINT_NEAR_THRESHOLD=10

# AI-generation detector: none | mock. Real providers are added as adapters under providers/ai.
VERIXA_AI_DETECTOR_PROVIDER=none
VERIXA_AI_DETECTOR_TIMEOUT_SECONDS=30
# Score thresholds -> evidence levels: >= high PROBABLE, >= medium POSSIBLE, else weak signal.
VERIXA_AI_SCORE_HIGH=0.85
VERIXA_AI_SCORE_MEDIUM=0.6

# Error Level Analysis (JPEG only): resave quality, working-size cap, outlier threshold (sigma)
# and the outlier-block fraction band that counts as a localised anomaly.
VERIXA_ELA_QUALITY=95
VERIXA_ELA_MAX_SIDE=3000
VERIXA_ELA_OUTLIER_SIGMA=2.5
VERIXA_ELA_ANOMALY_MIN_FRACTION=0.005
VERIXA_ELA_ANOMALY_MAX_FRACTION=0.2

# Compression block-grid detection: minimum relative strength of an 8 px periodicity.
VERIXA_COMPRESSION_GRID_MIN_STRENGTH=0.08

# Resampling detection: minimum spectral peak / local background ratio.
VERIXA_RESAMPLING_MIN_PEAK_RATIO=5.0

# Noise consistency: block size, outlier threshold (multiples of the IQR across smooth blocks)
# and the outlier-block fraction band that counts as a localised anomaly.
VERIXA_NOISE_BLOCK_SIZE=32
VERIXA_NOISE_OUTLIER_K=3.0
VERIXA_NOISE_ANOMALY_MIN_FRACTION=0.005
VERIXA_NOISE_ANOMALY_MAX_FRACTION=0.25

# Copy-move block matching: working-size cap, matching block pairs needed per displacement,
# minimum displacement in working pixels.
VERIXA_COPY_MOVE_MAX_SIDE=1024
VERIXA_COPY_MOVE_MIN_MATCHES=200
VERIXA_COPY_MOVE_MIN_SHIFT=32

# Evidence engine thresholds: language-detection confidence for PROBABLE, and how many
# independent forensic families must flag anomalies for STRONG.
VERIXA_LANGUAGE_PROBABLE_CONFIDENCE=0.9
VERIXA_FORENSIC_FAMILIES_FOR_STRONG=2
# Default confidence per level (possible <= probable <= strong <= verified), per-rule level
# overrides as JSON (only ever *lower* than the docs/07 ceiling takes effect), and the synthesis
# confidence penalty per conflict record.
VERIXA_EVIDENCE_CONFIDENCE_VERIFIED=1.0
VERIXA_EVIDENCE_CONFIDENCE_STRONG=0.8
VERIXA_EVIDENCE_CONFIDENCE_PROBABLE=0.65
VERIXA_EVIDENCE_CONFIDENCE_POSSIBLE=0.4
VERIXA_EVIDENCE_LEVEL_OVERRIDES={}
VERIXA_EVIDENCE_CONFLICT_PENALTY=0.25

# LLM synthesis: none | mock | openai. The model only ever receives structured evidence.
VERIXA_LLM_PROVIDER=none
VERIXA_LLM_TIMEOUT_SECONDS=60
VERIXA_LLM_PROMPT_VERSION=v1
VERIXA_OPENAI_API_KEY=
VERIXA_OPENAI_MODEL=gpt-4o-mini
VERIXA_OPENAI_BASE_URL=https://api.openai.com/v1
VERIXA_OPENAI_COST_PER_MILLION_INPUT=0
VERIXA_OPENAI_COST_PER_MILLION_OUTPUT=0

# Retention: raw content (originals, derived images, report files) expires after this many
# hours unless the analysis is kept (0 = never); provider raw responses are cleared after this
# many days (0 = never); soft-deleted records are purged after the grace period; live records
# older than VERIXA_ANALYSIS_RETENTION_DAYS are deleted (0 = keep); the in-process sweeper runs
# every N minutes (0 = disabled; run `python -m app.workers.retention` instead).
VERIXA_RAW_CONTENT_RETENTION_HOURS=24
VERIXA_PROVIDER_RESPONSE_RETENTION_DAYS=30
VERIXA_DELETED_RECORD_GRACE_DAYS=7
VERIXA_ANALYSIS_RETENTION_DAYS=0
VERIXA_RETENTION_SWEEP_INTERVAL_MINUTES=60

# Usage limits per user (0 = unlimited): analyses per calendar month, bytes currently held,
# provider cost (USD) per month after which paid provider steps are skipped.
VERIXA_USAGE_MONTHLY_ANALYSIS_LIMIT=0
VERIXA_USAGE_STORAGE_LIMIT_BYTES=0
VERIXA_USAGE_MONTHLY_PROVIDER_COST_LIMIT=0

# Provider-result cache TTL in hours (0 disables). Keyed by content hash + provider/model/version.
VERIXA_PROVIDER_CACHE_TTL_HOURS=168

# Source / reverse search: none | mock. Real providers are added as adapters under providers/search.
VERIXA_SOURCE_SEARCH_PROVIDER=none
VERIXA_SOURCE_SEARCH_TIMEOUT_SECONDS=30
VERIXA_TEXT_SEARCH_MAX_PHRASES=5

# Text near-duplicate detection: minimum estimated Jaccard similarity (0-1).
VERIXA_TEXT_NEAR_THRESHOLD=0.5

# Text input cap (characters).
VERIXA_MAX_TEXT_CHARS=200000

# Upload limits.
VERIXA_MAX_UPLOAD_BYTES=26214400
VERIXA_MAX_IMAGE_PIXELS=40000000

# Local runtime data root (SQLite file, local uploads). Git-ignored.
VERIXA_DATA_DIR=./data

# Database — default is SQLite at ${VERIXA_DATA_DIR}/verixa.db (no install needed).
# For PostgreSQL, set for example:
# VERIXA_DATABASE_URL=postgresql+asyncpg://verixa:verixa@localhost:5432/verixa

# Object storage — "local" (default, ${VERIXA_DATA_DIR}/storage) or "s3" (pip install -e ".[s3]").
VERIXA_STORAGE_BACKEND=local
# Public origin of the API; local-storage signed URLs point here.
VERIXA_API_PUBLIC_URL=http://localhost:8000
VERIXA_SIGNED_URL_TTL_SECONDS=300
# VERIXA_STORAGE_LOCAL_PATH=./data/storage

# Required only when VERIXA_STORAGE_BACKEND=s3 (private bucket; never public-read).
# VERIXA_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# VERIXA_S3_REGION=auto
# VERIXA_S3_BUCKET=verixa-private
# VERIXA_S3_ACCESS_KEY_ID=
# VERIXA_S3_SECRET_ACCESS_KEY=

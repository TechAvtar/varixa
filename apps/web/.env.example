# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side override for the same setting (runtime, never sent to the browser). Used when the
# API is reached over a private network, e.g. http://api:8000 inside infra/compose.yml.
# API_BASE_URL=http://api:8000
